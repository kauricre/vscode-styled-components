{
  "name": "vscode-styled-components-modern",
  "displayName": "Styled Components (Modern CSS)",
  "description": "Syntax highlighting, IntelliSense, and modern-CSS support for styled-components — maintained fork, refreshed for 2026 CSS (oklch, @container, :has, and more).",
  "version": "1.9.0",
  "publisher": "kauricre",
  "keywords": [
    "styled-components",
    "styled components",
    "css-in-js",
    "css",
    "styled",
    "react",
    "emotion",
    "syntax highlighting",
    "intellisense"
  ],
  "icon": "logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kauricre/vscode-styled-components.git"
  },
  "main": "dist/extension.js",
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "compile": "node ./build.mjs",
    "pretest": "npm run compile",
    "test": "node ./src/tests/runTests.js",
    "watch": "node ./build.mjs --watch",
    "vscode:prepublish": "node ./build.mjs --production",
    "prepare": "husky install",
    "audit:recon": "node audit/recon.js",
    "audit:data": "node audit/probe-data.js",
    "audit:corpus": "node audit/probe-corpus.js",
    "audit:test": "node --test audit/corpus.test.js audit/probe-data.test.js audit/probe-corpus.test.js audit/report.test.js src/colorMatch.test.js src/snippetContext.test.js",
    "audit:editor": "npm run compile && node audit/editor/run.js",
    "audit": "node audit/run.js && npm run audit:editor && node audit/report.js"
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:vue",
    "onLanguage:svelte"
  ],
  "contributes": {
    "languages": [
      {
        "id": "source.css.styled",
        "aliases": [
          "CSS (Styled Components)"
        ],
        "configuration": "./css.styled.configuration.json"
      }
    ],
    "configuration": {
      "title": "Styled Components (Modern CSS)",
      "properties": {
        "styled-components.validate": {
          "type": "boolean",
          "default": true,
          "description": "Report CSS errors inside styled template literals. Turn off if another tool (e.g. Stylelint) already lints your styles."
        },
        "styled-components.tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "styled",
            "css",
            "extend",
            "injectGlobal",
            "createGlobalStyle",
            "keyframes"
          ],
          "description": "Tagged-template names treated as styled-components CSS by IntelliSense. Syntax highlighting for custom names is not yet configurable (planned)."
        },
        "styled-components.lint": {
          "type": "object",
          "default": {},
          "description": "Lint options forwarded to the CSS language service, e.g. {\"validProperties\": [\"composes\"]} to allow-list custom properties or {\"emptyRules\": \"warning\"}."
        },
        "styled-components.emmet": {
          "type": "object",
          "default": {},
          "description": "Emmet preferences inside styled templates, e.g. {\"showExpandedAbbreviation\": \"never\"} to silence Emmet suggestions there."
        }
      }
    },
    "grammars": [
      {
        "language": "source.css.styled",
        "scopeName": "source.css.styled",
        "path": "./syntaxes/css.styled.json"
      },
      {
        "injectTo": [
          "source.js",
          "source.ts",
          "source.jsx",
          "source.js.jsx",
          "source.tsx",
          "source.vue",
          "source.svelte"
        ],
        "scopeName": "styled",
        "path": "./syntaxes/styled-components.json",
        "embeddedLanguages": {
          "source.css.scss": "css",
          "meta.embedded.line.ts": "typescript"
        }
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "@styled/typescript-styled-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "commands": [
      {
        "command": "extension.insertColonOrSemiColon",
        "title": "Fix Colon and Semicolon"
      }
    ],
    "keybindings": [
      {
        "command": "extension.insertColonOrSemiColon",
        "key": "enter",
        "when": "suggestWidgetVisible && textInputFocus && editorLangId =~ /javascript|typescript|javascriptreact|typescriptreact/ && config.editor.acceptSuggestionOnEnter != 'off'"
      }
    ]
  },
  "dependencies": {
    "@styled/typescript-styled-plugin": "^1.0.0",
    "vscode-css-languageservice": "^6.3.10"
  },
  "devDependencies": {
    "@types/glob": "^7.2.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^18.11.9",
    "@types/vscode": "^1.73.1",
    "@vscode/test-electron": "^2.5.2",
    "css-latest": "npm:vscode-css-languageservice@^6.3.10",
    "culori": "^4.0.2",
    "esbuild": "^0.19.9",
    "glob": "7.1.6",
    "husky": "^7.0.4",
    "mocha": "^9.2.1",
    "prettier": "^2.8.0",
    "typescript": "^5.0.3"
  }
}
